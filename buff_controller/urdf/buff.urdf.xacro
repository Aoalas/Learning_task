<?xml version="1.0"?>

<robot name="buff" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin name="ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/</robotNamespace>
        </plugin>
    </gazebo>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.5 2"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.5 0.5 2"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <inertia ixx="3.542" ixy="0.0" ixz="0.0" iyy="3.542" iyz="0.0" izz="0.417"/>
        </inertial>
    </link>

    <link name="base">
        <visual>
            <geometry>
                <box size="2 2 0.4"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="2 2 0.4"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <inertia ixx="3.333333" ixy="0" ixz="0" iyy="3.333333" iyz="0" izz="6.666667"/>
        </inertial>
    </link>

    <link name="wheel">
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.1"/>
            </geometry>
            <material name="white">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5" radius="0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="0.0012083" ixy="0.0" ixz="0.0" iyy="0.0012083" iyz="0.0" izz="0.0003333"/>
        </inertial>
    </link>

    <link name="stick">
        <visual>
            <geometry>
                <cylinder length="1" radius="0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="1" radius="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.0004017" ixy="0" ixz="0" iyy="0.0004017" iyz="0" izz="0.000006"/>
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base"/>
        <origin xyz="0 0 -0.8" rpy="0 0 0"/>
    </joint>

    <joint name="wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel"/>
        <origin xyz="0.5 0 0.6" rpy="0 1.57 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <joint name="stick_joint" type="fixed">
        <parent link="wheel"/>
        <child link="stick"/>
        <origin xyz="0.5 0 0.15" rpy="0 1.57 0"/>
    </joint>

    <transmission name="trans">
        <type>transmission_interface/SimpleTransmission</type>
        <actuator name="motors">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1.0</mechanicalReduction>
        </actuator>
        <joint name="wheel_joint">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        </joint>
    </transmission>

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="wheel">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="stick">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="base">
        <material>Gazebo/Blue</material>
    </gazebo>
</robot>
