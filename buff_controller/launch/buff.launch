<?xml version="1.0" encoding="utf-8"?>
<launch>

    <param name="robot_description" command="$(find xacro)/xacro $(find buff_controller)/urdf/buff.urdf.xacro"/>

    <arg name="paused" default="true"/>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="$(arg paused)"/>
        <arg name="world_name" value="$(find rm_gazebo)/worlds/empty.world"/>
    </include>

    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" clear_params="true"
          args="-z 1.5 -param robot_description -urdf -model buff" output="screen"/>

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <rosparam file="$(find buff_controller)/config/controller.yaml" command="load"/>
    <rosparam file="$(find buff_controller)/config/motor.yaml" command="load"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
          output="screen" args="
        controller/buff_controller
        controller/joint_state_controller">
    </node>

    <rosparam file="$(find rm_hw)/config/actuator_coefficient.yaml" command="load" ns="rm_hw"/>
    <rosparam file="$(find buff_controller)/config/motor.yaml" command="load"/>

<!--    <node name="rm_hw" pkg="rm_hw" type="rm_hw" respawn="false"-->
<!--          clear_params="true"/>-->

</launch>
